# Database
DATABASE_URL='postgresql://user:password@host:port/database?sslmode=require'
# DATABASE_SSL_MODE=require

# App
NEXT_PUBLIC_APP_URL='http://localhost:8080'

# Billing provider: stripe or creem
NEXT_PUBLIC_BILLING_PROVIDER='stripe'

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET='replace_with_new_secret'

# Optional Google OAuth
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''

# Email via Resend
RESEND_API_KEY='re_replace_with_imaima_queencard_key'
RESEND_FROM='imaima queencard <noreply@yourdomain.com>'

# Stripe
STRIPE_API_KEY='sk_test_replace_with_imaima_queencard_key'
STRIPE_WEBHOOK_SECRET='whsec_replace_with_imaima_queencard_webhook_secret'
NEXT_PUBLIC_STRIPE_PRO_PRODUCT_ID=''
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=''
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=''
NEXT_PUBLIC_STRIPE_BUSINESS_PRODUCT_ID=''
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PRICE_ID=''
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PRICE_ID=''

# Creem, only if using Creem instead of Stripe
CREEM_API_KEY=''
CREEM_WEBHOOK_SECRET=''

# Admin and debug
ADMIN_EMAIL='your-admin@example.com'
IS_DEBUG=false
