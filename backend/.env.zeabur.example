NODE_ENV=production
BUILD_SHA=replace-with-source-commit-sha
PORT=8080
MINIAPP_BACKEND_HOST=0.0.0.0
MINIAPP_DEV_LOGIN=0
WECHAT_MINIAPP_APP_ID=wx5949306a2777910c
WECHAT_MINIAPP_APP_SECRET=replace-with-wechat-miniapp-secret
MINIAPP_AUTH_TOKEN_SECRET=replace-with-long-random-secret
DATABASE_URL=postgres://replace-with-database-url
DATABASE_SSL=1
MINIAPP_INITIAL_CREDITS=10
MINIAPP_DB_PATH=/data/miniapp.sqlite
MINIAPP_UPLOAD_ROOT=/data/uploads
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://replace-with-s3-endpoint
STORAGE_REGION=auto
STORAGE_BUCKET=replace-with-storage-bucket
STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=0
MINIAPP_TEMPLATE_SOURCE=github
MINIAPP_PUBLIC_ASSET_BASE_URL=https://replace-with-your-zeabur-domain
GENERATION_PROVIDER=preview
GENERATION_WORKER_MODE=durable
GENERATION_WORKER_CONCURRENCY=1
GENERATION_UPSTREAM_BASE_URL=
GENERATION_UPSTREAM_AUTH_TOKEN=
MINIAPP_PAYMENT_MODE=manual
PAYMENT_PROVIDER=disabled
MINIAPP_PRICING_JSON=
MINIAPP_WECHAT_PAYMENT_PARAMS_JSON=
MINIAPP_ADMIN_OPENIDS=
MINIAPP_ADMIN_USER_IDS=
MINIAPP_IMAGE_PROVIDER=preview
MINIAPP_MOCK_IMAGE_URL=
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
GPTPROTO_API_KEY=
GPTPROTO_BASE_URL=https://gptproto.com
GPTPROTO_IMAGE_ENDPOINT=/v1/images/generations
GPTPROTO_IMAGE_MODEL=gpt-image-2
