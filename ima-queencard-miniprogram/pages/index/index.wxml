<view class="page">
  <view class="hero">
    <view class="nav">
      <view class="brand">
        <text class="brand-main">ima ima</text>
        <text class="brand-accent">queencard</text>
      </view>
      <button class="nav-action" bindtap="showTryNotice">体验</button>
    </view>

    <view class="hero-deco deco-one"></view>
    <view class="hero-deco deco-two"></view>
    <view class="hero-deco deco-three"></view>

    <view class="eyebrow">{{landing.hero.eyebrow}}</view>

    <view class="hero-title">
      <text class="hero-line">{{landing.hero.titleLineOne}}</text>
      <view class="word-row">
        <text wx:for="{{landing.hero.highlightWords}}" wx:key="*this" class="word-chip">{{item}}</text>
      </view>
      <text class="hero-line">{{landing.hero.titleLineTwo}}</text>
      <text class="hero-line">{{landing.hero.titleLineThree}}</text>
    </view>

    <text class="hero-subtitle">{{landing.hero.subtitle}}</text>

    <view class="hero-actions">
      <button class="button primary" bindtap="scrollToTemplates">看模板</button>
      <button class="button secondary" bindtap="scrollToGallery">看生成对比</button>
    </view>

    <view class="stat-grid">
      <view wx:for="{{landing.hero.badges}}" wx:key="label" class="stat-card tone-{{item.tone}}">
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view id="templates" class="section template-feed">
    <view class="section-head">
      <view>
        <text class="section-kicker">TEMPLATES</text>
        <text class="section-title">下拉模板，直接生成同款</text>
      </view>
      <button class="feed-refresh" loading="{{templateLoading}}" bindtap="loadTemplates" data-reset="{{true}}">刷新</button>
    </view>

    <view wx:if="{{!templateReady}}" class="feed-empty">
      <text class="feed-empty-title">动态模板待连接</text>
      <text class="feed-empty-copy">配置模板 API 后，这里会按分页加载模板，不会把 1000+ 模板打进小程序包。</text>
    </view>

    <view wx:elif="{{templateError}}" class="feed-empty">
      <text class="feed-empty-title">模板暂时没加载出来</text>
      <text class="feed-empty-copy">{{templateError}}</text>
      <button class="small-feed-button" bindtap="loadTemplates" data-reset="{{true}}">重试</button>
    </view>

    <view wx:else class="template-list">
      <view wx:for="{{templates}}" wx:for-item="template" wx:key="id" class="template-card">
        <image wx:if="{{template.thumbnailUrl}}" class="template-image" mode="aspectFill" src="{{template.thumbnailUrl}}" />
        <view wx:else class="template-image placeholder-image">
          <text>ima</text>
        </view>
        <view class="template-copy">
          <view class="template-meta">
            <text>{{template.scenarioCategory || template.category}}</text>
            <text>{{template.source}}</text>
          </view>
          <text class="template-title">{{template.title}}</text>
          <text class="template-desc">{{template.useCase}}</text>
          <button class="template-button" loading="{{templateGeneratingId === template.id}}" data-id="{{template.id}}" bindtap="generateTemplate">生成同款</button>
        </view>
      </view>
      <view wx:if="{{templateLoading}}" class="feed-loading">模板加载中...</view>
      <view wx:if="{{!templateLoading && !templateHasMore && templates.length > 0}}" class="feed-loading">已加载当前全部模板</view>
      <view wx:if="{{!templateLoading && templates.length === 0}}" class="feed-loading">暂无模板</view>
    </view>
  </view>

  <view class="section contrast">
    <text class="section-title">{{landing.contrast.title}}</text>
    <view class="contrast-grid">
      <view class="panel panel-white">
        <text class="mini-label">{{landing.contrast.pain.label}}</text>
        <text class="panel-title">{{landing.contrast.pain.title}}</text>
        <view class="list">
          <text wx:for="{{landing.contrast.pain.items}}" wx:key="*this" class="list-item">· {{item}}</text>
        </view>
      </view>
      <view class="panel panel-seafoam">
        <text class="mini-label">{{landing.contrast.solution.label}}</text>
        <text class="panel-title">{{landing.contrast.solution.title}}</text>
        <view class="list">
          <text wx:for="{{landing.contrast.solution.items}}" wx:key="*this" class="list-item">· {{item}}</text>
        </view>
      </view>
    </view>
    <text class="section-note">{{landing.contrast.note}}</text>
  </view>

  <view class="section process">
    <text class="section-kicker">HOW IT WORKS</text>
    <text class="section-title">3 步从收藏爆款到做出自己的内容</text>
    <view class="step-list">
      <view wx:for="{{landing.steps}}" wx:key="num" class="step-card">
        <text class="step-num">{{item.num}}</text>
        <view class="step-copy">
          <text class="step-title">{{item.title}}</text>
          <text class="step-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="divider">
      <text>真实案例</text>
      <view></view>
    </view>

    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="proof-scroll">
      <view class="proof-row">
        <view wx:for="{{landing.proofs}}" wx:key="value" class="proof-card tone-{{item.tone}}">
          <image class="proof-image" mode="aspectFill" src="{{item.img}}" />
          <view class="proof-copy">
            <text class="proof-value">{{item.value}}</text>
            <text class="proof-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <text class="fineprint">以上为用户提供的公开案例素材，仅供参考。</text>
  </view>

  <view class="marquee" aria-label="features marquee">
    <view class="marquee-track">
      <view wx:for="{{landing.marquee}}" wx:key="*this" class="marquee-item">
        <text>{{item}}</text>
        <view></view>
      </view>
      <view wx:for="{{landing.marquee}}" wx:key="index" class="marquee-item">
        <text>{{item}}</text>
        <view></view>
      </view>
    </view>
  </view>

  <view id="gallery" class="section gallery">
    <text class="section-title">你给参考图，ima ima queencard 给你成套结果</text>
    <view class="comparison-list">
      <view wx:for="{{landing.comparisons}}" wx:for-item="caseItem" wx:key="type" class="comparison-card">
        <view class="comparison-head">
          <text class="comparison-type">{{caseItem.type}}</text>
          <view class="tag-row">
            <text wx:for="{{caseItem.tags}}" wx:for-item="tagItem" wx:key="*this" class="tag">{{tagItem}}</text>
          </view>
        </view>
        <view class="image-flow">
          <view class="input-col">
            <text class="image-label">参考图</text>
            <image class="input-image" mode="aspectFill" src="{{caseItem.inputImg}}" data-current="{{caseItem.inputImg}}" data-urls="{{caseItem.previewImgs}}" bindtap="previewCase" />
          </view>
          <text class="arrow">→</text>
          <view class="output-col">
            <text class="image-label">生成结果</text>
            <view class="output-row">
              <image wx:for="{{caseItem.outputImgs}}" wx:for-item="outputImg" wx:key="*this" class="output-image" mode="aspectFill" src="{{outputImg}}" data-current="{{outputImg}}" data-urls="{{caseItem.outputImgs}}" bindtap="previewCase" />
            </view>
          </view>
        </view>
      </view>
    </view>
    <text class="fineprint">以上为真实案例素材，实际效果以产品生成结果为准。</text>
  </view>

  <view class="section usecases">
    <view class="section-head">
      <text class="section-title">这些方向更适合用 ima ima queencard 放大</text>
      <text class="section-summary">只要核心模式是「靠图文积累人群」，ima ima queencard 都能帮你快起来。</text>
    </view>
    <view class="usecase-grid">
      <view wx:for="{{landing.useCases}}" wx:key="title" class="usecase-card tone-{{item.tone}}">
        <view class="usecase-copy">
          <text class="usecase-title">{{item.title}}</text>
          <text class="usecase-desc">{{item.desc}}</text>
        </view>
        <image class="usecase-image" mode="aspectFill" src="{{item.image}}" />
      </view>
    </view>
  </view>

  <view class="final-cta">
    <text class="final-title">别再一张张抽卡了</text>
    <text class="final-copy">你已经积累了那么多收藏，是时候让它们真正派上用场了。</text>
    <view class="hero-actions">
      <button class="button dark" bindtap="openGenerate">上传参考图</button>
      <button class="button light" bindtap="copyPrompt">复制提示语</button>
    </view>
  </view>

  <view class="footer">
    <text class="footer-brand">ima ima queencard</text>
    <text class="footer-copy">爆款图驱动的图文生成工具</text>
  </view>
</view>
