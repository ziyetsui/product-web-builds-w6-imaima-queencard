<view class="page">
  <view class="topbar">
    <button class="icon-button" bindtap="createAnother">‹</button>
    <view class="brand">
      <text class="brand-main">ima ima</text>
      <text class="brand-accent">queencard</text>
    </view>
    <button class="refresh-button" loading="{{loading}}" bindtap="manualRefresh">刷新</button>
  </view>

  <view wx:if="{{!apiReady}}" class="status-card">
    <text class="status-title">后端未配置</text>
    <text class="status-desc">请先设置 config/env.js 的 API_BASE_URL，并启动独立小程序后端。</text>
  </view>

  <view wx:elif="{{!taskId}}" class="status-card">
    <text class="status-title">缺少任务 ID</text>
    <text class="status-desc">请回到生成页重新提交任务。</text>
    <button class="primary-button" bindtap="createAnother">重新生成</button>
  </view>

  <view wx:else>
    <view class="status-card">
      <text class="kicker">TASK {{taskId}}</text>
      <text class="status-title">{{statusTitle}}</text>
      <text class="status-desc">{{statusDesc}}</text>
      <text wx:if="{{error}}" class="error">{{error}}</text>
    </view>

    <view wx:if="{{images.length > 0}}" class="result-grid">
      <view wx:for="{{images}}" wx:key="*this" class="image-card">
        <image class="result-image" mode="aspectFill" src="{{item}}" data-current="{{item}}" bindtap="previewImage" />
        <button class="save-button" data-url="{{item}}" bindtap="saveImage">保存</button>
      </view>
    </view>

    <view wx:else class="empty-card">
      <view class="spinner"></view>
      <text class="empty-title">{{loading ? '正在同步结果' : '还没有图片结果'}}</text>
      <text class="empty-desc">任务完成后，后端返回的 images/resultImages/outputImages 会显示在这里。</text>
    </view>

    <button class="primary-button" bindtap="createAnother">再生成一组</button>
  </view>
</view>
