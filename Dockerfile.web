FROM node:22-slim AS deps

WORKDIR /app/frontend

COPY ["web/imaima-queencard/frontend/package.json", "web/imaima-queencard/frontend/pnpm-lock.yaml", "./"]
RUN npm install -g pnpm@10.33.0 && pnpm install --frozen-lockfile

FROM node:22-slim AS builder

WORKDIR /app/frontend

ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_BILLING_PROVIDER
ARG NEXT_PUBLIC_GOOGLE_AUTH_ENABLED
ARG NEXT_PUBLIC_ENTER_ANALYTICS_ENABLED
ARG NEXT_PUBLIC_ENTER_ANALYTICS_TOKEN
ARG NEXT_PUBLIC_ENTER_PROJECT_ID
ARG NEXT_PUBLIC_ENTER_ANALYTICS_ENDPOINT
ARG NEXT_PUBLIC_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT
ARG NEXT_PUBLIC_ENTER_ANALYTICS_DEBUG
ARG NEXT_PUBLIC_ASSET_BASE_URL
ARG NEXT_PUBLIC_XHS_CASES_CDN_URL

ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_BILLING_PROVIDER=${NEXT_PUBLIC_BILLING_PROVIDER}
ENV NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=${NEXT_PUBLIC_GOOGLE_AUTH_ENABLED}
ENV NEXT_PUBLIC_ENTER_ANALYTICS_ENABLED=${NEXT_PUBLIC_ENTER_ANALYTICS_ENABLED}
ENV NEXT_PUBLIC_ENTER_ANALYTICS_TOKEN=${NEXT_PUBLIC_ENTER_ANALYTICS_TOKEN}
ENV NEXT_PUBLIC_ENTER_PROJECT_ID=${NEXT_PUBLIC_ENTER_PROJECT_ID}
ENV NEXT_PUBLIC_ENTER_ANALYTICS_ENDPOINT=${NEXT_PUBLIC_ENTER_ANALYTICS_ENDPOINT}
ENV NEXT_PUBLIC_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT=${NEXT_PUBLIC_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT}
ENV NEXT_PUBLIC_ENTER_ANALYTICS_DEBUG=${NEXT_PUBLIC_ENTER_ANALYTICS_DEBUG}
ENV NEXT_PUBLIC_ASSET_BASE_URL=${NEXT_PUBLIC_ASSET_BASE_URL}
ENV NEXT_PUBLIC_XHS_CASES_CDN_URL=${NEXT_PUBLIC_XHS_CASES_CDN_URL}

COPY --from=deps /app/frontend/node_modules ./node_modules
COPY ["web/imaima-queencard/frontend", "./"]
RUN npm install -g pnpm@10.33.0 && pnpm build

FROM node:22-slim AS runner

LABEL "language"="nodejs"
LABEL "framework"="next.js"
LABEL "service"="ima-queencard-web"

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=8080

COPY --from=builder /app/frontend/public ./public
COPY --from=builder /app/frontend/.next/static ./.next/static
COPY --from=builder /app/frontend/.next/standalone ./

EXPOSE 8080

CMD ["node", "server.js"]
