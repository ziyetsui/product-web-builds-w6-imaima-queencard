.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 64rpx;
  background: #f6e0db;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.icon-button,
.small-button,
.clear-button {
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  box-shadow: 6rpx 6rpx 0 rgba(13, 13, 13, 0.13);
  color: #0d0d0d;
  font-weight: 900;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  background: #fff;
  font-size: 34rpx;
  line-height: 1;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-weight: 900;
  line-height: 1;
}

.brand-main,
.brand-accent {
  font-size: 30rpx;
}

.brand-accent {
  color: #ef724f;
}

.status-dot {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 50%;
}

.ready {
  background: #6ed311;
}

.offline {
  background: #ef724f;
}

.hero-panel,
.search-panel,
.notice-card,
.empty-card,
.record-card {
  margin-bottom: 24rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  box-shadow: 8rpx 8rpx 0 rgba(13, 13, 13, 0.13);
}

.hero-panel {
  padding: 34rpx 30rpx 38rpx;
  background: #ace2df;
}

.kicker {
  display: block;
  margin-bottom: 18rpx;
  color: rgba(13, 13, 13, 0.55);
  font-size: 22rpx;
  font-weight: 900;
}

.title {
  display: block;
  margin-bottom: 18rpx;
  color: #0d0d0d;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.08;
}

.subtitle {
  display: block;
  color: rgba(13, 13, 13, 0.72);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.48;
}

.search-panel {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx;
  background: #fff;
}

.filter-panel {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 18rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #ace2df;
}

.filter-label {
  color: #0d0d0d;
  font-size: 24rpx;
  font-weight: 900;
}

.filter-picker {
  min-width: 180rpx;
  padding: 10rpx 16rpx;
  border: 3rpx solid #0d0d0d;
  border-radius: 8px;
  background: #fff;
  color: #0d0d0d;
  font-size: 23rpx;
  font-weight: 900;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #f6e0db;
  color: #0d0d0d;
  font-size: 26rpx;
  font-weight: 800;
}

.clear-button,
.small-button {
  min-width: 128rpx;
  height: 66rpx;
  padding: 0 20rpx;
  background: #fff;
  font-size: 24rpx;
}

.lemon {
  background: #e7db4c;
}

.pumpkin {
  background: #ef724f;
}

.notice-card,
.empty-card,
.login-card {
  padding: 30rpx;
  background: #e7db4c;
}

.login-card {
  background: #ace2df;
}

.notice-title,
.empty-title {
  display: block;
  margin-bottom: 12rpx;
  color: #0d0d0d;
  font-size: 32rpx;
  font-weight: 900;
}

.notice-copy,
.empty-desc {
  display: block;
  margin-bottom: 22rpx;
  color: rgba(13, 13, 13, 0.68);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
}

.record-card {
  overflow: hidden;
  background: #fff;
}

.record-main {
  display: flex;
  gap: 18rpx;
  padding: 20rpx;
}

.thumb-strip {
  display: flex;
  flex: 0 0 164rpx;
  width: 164rpx;
  height: 220rpx;
  gap: 6rpx;
  overflow: hidden;
}

.thumb-strip .record-image {
  flex: 0 0 164rpx;
}

.record-image,
.record-placeholder {
  flex: 0 0 164rpx;
  width: 164rpx;
  height: 220rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #f6e0db;
}

.record-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(13, 13, 13, 0.55);
  font-size: 24rpx;
  font-weight: 900;
}

.record-copy {
  flex: 1;
  min-width: 0;
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.record-title {
  flex: 1;
  min-width: 0;
  color: #0d0d0d;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  color: #0d0d0d;
  font-size: 20rpx;
  font-weight: 900;
}

.success {
  background: #ace2df;
}

.danger {
  background: #ef724f;
}

.waiting,
.running {
  background: #e7db4c;
}

.muted {
  background: #ececec;
}

.record-prompt {
  display: -webkit-box;
  margin-bottom: 16rpx;
  color: rgba(13, 13, 13, 0.66);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.38;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.record-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.record-meta text {
  padding: 5rpx 10rpx;
  border: 3rpx solid #0d0d0d;
  border-radius: 8px;
  background: #f6e0db;
  color: rgba(13, 13, 13, 0.68);
  font-size: 20rpx;
  font-weight: 800;
}

.record-actions {
  display: flex;
  gap: 14rpx;
  padding: 0 20rpx 20rpx;
}

.record-actions .small-button {
  flex: 1;
  min-width: 0;
}

.load-row {
  padding: 24rpx 0;
  color: rgba(13, 13, 13, 0.55);
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}
