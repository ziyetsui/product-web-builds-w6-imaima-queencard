<view class="page">
  <view class="topbar">
    <button class="icon-button" bindtap="refreshRecords">↻</button>
    <view class="brand">
      <text class="brand-main">ima ima</text>
      <text class="brand-accent">我的作品</text>
    </view>
    <view class="status-dot {{apiReady ? 'ready' : 'offline'}}"></view>
  </view>

  <view class="hero-panel">
    <text class="kicker">GENERATION HISTORY</text>
    <text class="title">找回每一次生成记录</text>
    <text class="subtitle">搜索提示词、模型或模板，点开查看结果，也可以直接拿第一张继续生成。</text>
  </view>

  <view class="search-panel">
    <input class="search-input" value="{{q}}" placeholder="搜索作品、提示词、模型" confirm-type="search" bindinput="onSearchInput" />
    <button wx:if="{{q}}" class="clear-button" bindtap="clearSearch">清除</button>
  </view>

  <view class="filter-panel">
    <text class="filter-label">状态</text>
    <picker range="{{statusFilters}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="filter-picker">{{statusFilters[statusIndex].label}}</view>
    </picker>
  </view>

  <view wx:if="{{loginRequired}}" class="login-card">
    <text class="empty-title">登录后查看作品</text>
    <text class="empty-desc">生成记录只属于当前微信小程序账号。</text>
    <button class="small-button lemon" loading="{{loading}}" bindtap="handleLogin">微信登录</button>
  </view>

  <view wx:if="{{error}}" class="notice-card">
    <text class="notice-title">加载失败</text>
    <text class="notice-copy">{{error}}</text>
    <button class="small-button lemon" bindtap="refreshRecords">重试</button>
  </view>

  <view wx:elif="{{!loginRequired && records.length === 0 && !loading}}" class="empty-card">
    <text class="empty-title">{{searched ? '没有匹配的作品' : '还没有生成记录'}}</text>
    <text class="empty-desc">{{searched ? '换个关键词试试，或清除搜索查看全部记录。' : '提交生成后，作品会按时间出现在这里。'}}</text>
    <button wx:if="{{searched}}" class="small-button white" bindtap="clearSearch">清除搜索</button>
  </view>

  <view wx:else class="record-list">
    <view wx:for="{{records}}" wx:key="id" class="record-card">
      <view class="record-main" data-id="{{item.id}}" bindtap="openRecord">
        <view wx:if="{{item.thumbnails.length}}" class="thumb-strip">
          <image wx:for="{{item.thumbnails}}" wx:key="url" class="record-image" mode="aspectFill" src="{{item.url}}" />
        </view>
        <view wx:else class="record-placeholder">
          <text>生成中</text>
        </view>
        <view class="record-copy">
          <view class="record-head">
            <text class="record-title">{{item.title}}</text>
            <text class="status-badge {{item.statusTone}}">{{item.statusLabel}}</text>
          </view>
          <text class="record-prompt">{{item.prompt || '暂无提示词'}}</text>
          <view class="record-meta">
            <text>{{item.model}}</text>
            <text>{{item.outputCount}} 张</text>
            <text>{{item.createdAtLabel}}</text>
          </view>
        </view>
      </view>
      <view class="record-actions">
        <button class="small-button white" data-id="{{item.id}}" bindtap="openRecord">查看结果</button>
        <button wx:if="{{item.status == 'failed' || item.status == 'error' || item.status == 'canceled' || item.status == 'cancelled'}}" class="small-button lemon" loading="{{retryingId == item.id}}" data-id="{{item.id}}" catchtap="retryRecord">重试</button>
        <button wx:else class="small-button pumpkin" data-id="{{item.id}}" data-image="{{item.firstImage}}" catchtap="reuseRecord">继续编辑</button>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="load-row">正在读取作品...</view>
  <view wx:elif="{{loadingMore}}" class="load-row">继续加载...</view>
  <view wx:elif="{{records.length > 0 && !hasMore}}" class="load-row">已经到底了</view>
</view>
