.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 64rpx;
  background: #f6e0db;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.icon-button,
.small-button {
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  box-shadow: 6rpx 6rpx 0 rgba(13, 13, 13, 0.13);
  color: #0d0d0d;
  font-weight: 900;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  background: #fff;
  font-size: 34rpx;
  line-height: 1;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-weight: 900;
  line-height: 1;
}

.brand-main,
.brand-accent {
  font-size: 30rpx;
}

.brand-accent {
  color: #ef724f;
}

.status-dot {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 50%;
}

.ready {
  background: #6ed311;
}

.offline {
  background: #ef724f;
}

.balance-panel,
.notice-card,
.section,
.empty-card,
.history-item {
  margin-bottom: 24rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  box-shadow: 8rpx 8rpx 0 rgba(13, 13, 13, 0.13);
}

.balance-panel {
  padding: 34rpx 30rpx;
  background: #ace2df;
}

.kicker {
  display: block;
  margin-bottom: 18rpx;
  color: rgba(13, 13, 13, 0.55);
  font-size: 22rpx;
  font-weight: 900;
}

.balance-number {
  display: block;
  color: #0d0d0d;
  font-size: 96rpx;
  font-weight: 900;
  line-height: 1;
}

.balance-label {
  display: block;
  margin-top: 12rpx;
  color: rgba(13, 13, 13, 0.65);
  font-size: 28rpx;
  font-weight: 800;
}

.balance-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 18rpx;
  color: rgba(13, 13, 13, 0.62);
  font-size: 23rpx;
  font-weight: 800;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 30rpx;
  padding: 18rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #fff;
  color: rgba(13, 13, 13, 0.72);
  font-size: 25rpx;
  font-weight: 900;
}

.account-row > text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 10rpx;
}

.small-button {
  min-width: 104rpx;
  height: 66rpx;
  padding: 0 16rpx;
  background: #fff;
  font-size: 24rpx;
}

.lemon {
  background: #e7db4c;
}

.pumpkin {
  background: #ef724f;
}

.white {
  background: #fff;
}

.notice-card {
  padding: 28rpx;
  background: #e7db4c;
}

.notice-title,
.section-title,
.empty-title,
.history-title {
  display: block;
  color: #0d0d0d;
  font-weight: 900;
}

.notice-title,
.section-title {
  font-size: 32rpx;
}

.notice-copy,
.empty-desc,
.history-desc,
.history-time {
  display: block;
  color: rgba(13, 13, 13, 0.62);
  font-weight: 700;
  line-height: 1.42;
}

.notice-copy {
  margin: 12rpx 0 22rpx;
  font-size: 25rpx;
}

.section {
  padding: 28rpx;
  background: #fff;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.section-hint {
  color: rgba(13, 13, 13, 0.48);
  font-size: 23rpx;
  font-weight: 800;
}

.empty-card {
  padding: 30rpx;
  background: #f6e0db;
  box-shadow: none;
}

.empty-title {
  margin-bottom: 10rpx;
  font-size: 30rpx;
}

.empty-desc {
  font-size: 24rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx;
  background: #f6e0db;
  box-shadow: none;
}

.history-copy {
  flex: 1;
  min-width: 0;
}

.history-title {
  margin-bottom: 8rpx;
  font-size: 28rpx;
}

.history-desc,
.history-time {
  font-size: 23rpx;
}

.history-desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount {
  flex: 0 0 auto;
  min-width: 100rpx;
  padding: 10rpx 14rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  color: #0d0d0d;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
}

.plus {
  background: #ace2df;
}

.minus {
  background: #ef724f;
}

.load-row {
  padding: 24rpx 0;
  color: rgba(13, 13, 13, 0.55);
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}
