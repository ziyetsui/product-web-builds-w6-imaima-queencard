<view class="page">
  <view class="topbar">
    <button class="icon-button" bindtap="backToGenerate">‹</button>
    <view class="brand">
      <text class="brand-main">ima ima</text>
      <text class="brand-accent">queencard</text>
    </view>
      <button class="refresh-button" loading="{{loading}}" bindtap="manualRefresh">刷新</button>
  </view>

  <view wx:if="{{!apiReady}}" class="status-card">
    <text class="status-title">后端未配置</text>
    <text class="status-desc">请先设置 config/env.js 的 API_BASE_URL，并启动独立小程序后端。</text>
  </view>

  <view wx:elif="{{!taskId}}" class="status-card">
    <text class="status-title">缺少任务 ID</text>
    <text class="status-desc">请回到生成页重新提交任务。</text>
    <button class="primary-button" bindtap="createAnother">重新生成</button>
  </view>

  <view wx:else>
    <view class="status-card">
      <text class="kicker">TASK {{taskId}}</text>
      <text class="status-title">{{statusTitle}}</text>
      <text class="status-desc">{{statusDesc}}</text>
      <view wx:if="{{task.prompt || task.model || task.outputCount}}" class="task-meta">
        <text wx:if="{{task.prompt}}" class="meta-line">{{task.prompt}}</text>
        <text wx:if="{{task.model}}" class="meta-chip">{{task.model}}</text>
        <text wx:if="{{task.outputCount}}" class="meta-chip">{{task.outputCount}} 张</text>
      </view>
      <text wx:if="{{error}}" class="error">{{error}}</text>
      <text wx:if="{{pollExhausted}}" class="poll-note">自动刷新已暂停，点击右上角刷新继续。</text>
    </view>

    <view class="action-row">
      <button class="secondary-button seafoam" bindtap="openHistory">我的作品</button>
      <button class="secondary-button pumpkin" loading="{{regenerating}}" bindtap="regenerateTask">重新生成同款</button>
    </view>

    <view wx:if="{{imageItems.length > 0}}" class="result-grid">
      <view wx:for="{{imageItems}}" wx:key="url" class="image-card">
        <image class="result-image" mode="aspectFill" src="{{item.url}}" data-current="{{item.url}}" bindtap="previewImage" />
        <view class="image-actions">
          <button class="save-button" data-index="{{index}}" loading="{{savingIndex == index}}" bindtap="saveImage">保存</button>
          <button class="reuse-button" data-index="{{index}}" bindtap="continueEditing">用这张继续编辑</button>
        </view>
      </view>
    </view>

    <view wx:else class="empty-card">
      <view class="spinner"></view>
      <text class="empty-title">{{loading ? '正在同步结果' : '还没有图片结果'}}</text>
      <text class="empty-desc">{{task.status == 'failed' || task.status == 'error' ? '本次没有生成输出，可以点击重新生成。' : '任务完成后，后端返回的生成输出会显示在这里。'}}</text>
    </view>

    <button class="primary-button" bindtap="createAnother">再生成一组</button>
  </view>
</view>
