.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 64rpx;
  background: #f6e0db;
}

.topbar {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr) 112rpx;
  align-items: center;
  margin-bottom: 30rpx;
}

.icon-button,
.refresh-button,
.primary-button,
.save-button,
.reuse-button,
.secondary-button {
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  box-shadow: 6rpx 6rpx 0 rgba(13, 13, 13, 0.13);
  color: #0d0d0d;
  font-weight: 900;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx !important;
  height: 68rpx;
  background: #fff;
  font-size: 46rpx;
  line-height: 1;
  justify-self: start;
}

.refresh-button {
  width: 112rpx !important;
  min-width: 112rpx;
  height: 66rpx;
  background: #e7db4c;
  font-size: 24rpx;
  justify-self: end;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-weight: 900;
  line-height: 1;
  min-width: 0;
}

.brand-main,
.brand-accent {
  font-size: 30rpx;
}

.brand-accent {
  color: #ef724f;
}

.status-card,
.empty-card,
.image-card {
  margin-bottom: 24rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  box-shadow: 8rpx 8rpx 0 rgba(13, 13, 13, 0.13);
}

.status-card {
  padding: 34rpx 30rpx;
  background: #ace2df;
}

.kicker {
  display: block;
  margin-bottom: 16rpx;
  color: rgba(13, 13, 13, 0.48);
  font-size: 20rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.status-title {
  display: block;
  margin-bottom: 16rpx;
  color: #0d0d0d;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.08;
}

.status-desc {
  display: block;
  color: rgba(13, 13, 13, 0.72);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.48;
}

.task-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.meta-line {
  display: block;
  width: 100%;
  max-height: 112rpx;
  overflow: hidden;
  color: rgba(13, 13, 13, 0.72);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.42;
}

.meta-chip {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #fff;
  color: #0d0d0d;
  font-size: 20rpx;
  font-weight: 900;
}

.error {
  display: block;
  margin-top: 18rpx;
  padding: 16rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #ef724f;
  color: #0d0d0d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.poll-note {
  display: block;
  margin-top: 14rpx;
  color: rgba(13, 13, 13, 0.62);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.secondary-button {
  width: 100% !important;
  min-width: 0;
  height: 78rpx;
  font-size: 25rpx;
}

.secondary-button.seafoam {
  background: #ace2df;
}

.secondary-button.pumpkin {
  background: #ef724f;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.image-card {
  overflow: hidden;
  background: #fff;
}

.result-image {
  display: block;
  width: 100%;
  height: 420rpx;
  background: #ececec;
}

.image-actions {
  display: grid;
  grid-template-columns: 138rpx 1fr;
}

.save-button,
.reuse-button {
  width: 100% !important;
  height: 72rpx;
  border-bottom: 0;
  border-radius: 0;
  box-shadow: none;
  font-size: 24rpx;
}

.save-button {
  border-right: 0;
  border-left: 0;
  background: #e7db4c;
}

.reuse-button {
  border-right: 0;
  background: #ace2df;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 500rpx;
  padding: 40rpx;
  background: #fff;
}

.spinner {
  width: 86rpx;
  height: 86rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 50%;
  background: #e69dff;
}

.empty-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  display: block;
  color: rgba(13, 13, 13, 0.58);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: center;
}

.primary-button {
  width: 100% !important;
  height: 90rpx;
  background: #ef724f;
  font-size: 30rpx;
}

button[disabled] {
  opacity: 0.55;
}
