.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 64rpx;
  background: #f6e0db;
}

.topbar,
.section-head,
.row-card {
  display: flex;
  align-items: center;
}

.topbar {
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.icon-button,
.text-button,
.submit-button {
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  box-shadow: 6rpx 6rpx 0 rgba(13, 13, 13, 0.13);
  color: #0d0d0d;
  font-weight: 900;
}

.icon-button {
  width: 68rpx;
  height: 68rpx;
  background: #fff;
  font-size: 34rpx;
  line-height: 1;
}

.text-button {
  min-width: 92rpx;
  height: 66rpx;
  padding: 0 20rpx;
  background: #fff;
  font-size: 24rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-weight: 900;
  line-height: 1;
}

.brand-main,
.brand-accent {
  font-size: 30rpx;
}

.brand-accent {
  color: #ef724f;
}

.summary-panel,
.notice-card,
.form-card,
.section,
.row-card {
  margin-bottom: 24rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  box-shadow: 8rpx 8rpx 0 rgba(13, 13, 13, 0.13);
}

.summary-panel {
  padding: 30rpx 28rpx;
  background: #e69dff;
}

.kicker {
  display: block;
  margin-bottom: 14rpx;
  color: rgba(13, 13, 13, 0.55);
  font-size: 21rpx;
  font-weight: 900;
}

.title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.08;
}

.subtitle,
.notice-copy,
.row-desc,
.status,
.section-hint {
  display: block;
  color: rgba(13, 13, 13, 0.64);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.42;
}

.notice-card,
.form-card,
.section {
  padding: 24rpx;
  background: #fff;
}

.notice-card.warning {
  background: #e7db4c;
}

.notice-title,
.section-title,
.row-title,
.amount {
  display: block;
  color: #0d0d0d;
  font-weight: 900;
}

.notice-title,
.section-title {
  font-size: 30rpx;
}

.notice-copy {
  margin-top: 10rpx;
}

.input {
  height: 72rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #f6e0db;
  font-size: 25rpx;
  font-weight: 800;
}

.submit-button {
  width: 100%;
  height: 76rpx;
  margin-top: 18rpx;
  background: #ef724f;
  font-size: 26rpx;
}

.section-head {
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.row-card {
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx;
  background: #f6e0db;
  box-shadow: none;
}

.row-card.active {
  background: #ace2df;
}

.row-card.audit {
  align-items: flex-start;
}

.row-copy {
  flex: 1;
  min-width: 0;
}

.row-title {
  margin-bottom: 6rpx;
  font-size: 27rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-desc {
  overflow-wrap: anywhere;
}

.row-side {
  min-width: 120rpx;
  text-align: right;
}

.amount {
  font-size: 28rpx;
}

.load-row {
  padding: 24rpx 0;
  color: rgba(13, 13, 13, 0.55);
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}
