<view class="page">
  <view class="topbar">
    <button class="icon-button" bindtap="loadPage">↻</button>
    <view class="brand">
      <text class="brand-main">ima ima</text>
      <text class="brand-accent">订单账单</text>
    </view>
    <button class="text-button" bindtap="goAccount">账号</button>
  </view>

  <view class="summary-panel">
    <text class="kicker">BILLING</text>
    <text class="title">{{orders.length}} 笔订单</text>
    <text class="subtitle">订单来自 /api/miniapp/orders，账单来自 /api/miniapp/billing。</text>
  </view>

  <view wx:if="{{error}}" class="notice-card">
    <text class="notice-title">读取失败</text>
    <text class="notice-copy">{{error}}</text>
  </view>

  <view class="tab-row">
    <button class="tab-button {{activeTab === 'orders' ? 'active' : ''}}" data-tab="orders" bindtap="selectTab">订单</button>
    <button class="tab-button {{activeTab === 'billing' ? 'active' : ''}}" data-tab="billing" bindtap="selectTab">账单</button>
    <button class="tab-button buy" bindtap="goPricing">购买</button>
  </view>

  <view wx:if="{{activeTab === 'orders'}}" class="list">
    <view wx:if="{{orders.length === 0 && !loading}}" class="empty-card">
      <text class="empty-title">暂无订单</text>
      <text class="empty-desc">购买积分后会显示订单和支付状态。</text>
    </view>
    <view wx:for="{{orders}}" wx:key="id" class="row-card {{highlightedOrderId === item.id ? 'highlight' : ''}}">
      <view class="row-copy">
        <text class="row-title">{{item.title}}</text>
        <text class="row-desc">{{item.desc}}</text>
        <text class="row-time">{{item.createdAtLabel}}</text>
      </view>
      <view class="row-side">
        <text class="amount">{{item.amount}}</text>
        <text class="status {{item.statusKey}}">{{item.status}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'billing'}}" class="list">
    <view wx:if="{{billingRows.length === 0 && !loading}}" class="empty-card">
      <text class="empty-title">暂无账单</text>
      <text class="empty-desc">支付成功、退款或订阅变更会显示在这里。</text>
    </view>
    <view wx:for="{{billingRows}}" wx:key="id" class="row-card">
      <view class="row-copy">
        <text class="row-title">{{item.title}}</text>
        <text class="row-desc">{{item.desc}}</text>
        <text class="row-time">{{item.createdAtLabel}}</text>
      </view>
      <view class="row-side">
        <text class="amount">{{item.amount}}</text>
        <text class="status">{{item.status}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="load-row">正在读取订单...</view>
</view>
