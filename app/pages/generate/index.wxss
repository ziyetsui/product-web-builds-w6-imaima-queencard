.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  background: #f6e0db;
}

.topbar {
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr) 68rpx;
  align-items: center;
  margin-bottom: 22rpx;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx !important;
  height: 68rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #fff;
  color: #0d0d0d;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
  justify-self: start;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-weight: 900;
  line-height: 1;
  min-width: 0;
}

.brand-main,
.brand-accent {
  font-size: 30rpx;
}

.brand-accent {
  color: #ef724f;
}

.status-dot {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 50%;
  justify-self: end;
}

.ready {
  background: #6ed311;
}

.offline {
  background: #ef724f;
}

.hero-panel,
.notice-card,
.section {
  margin-bottom: 18rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  box-shadow: 8rpx 8rpx 0 rgba(13, 13, 13, 0.13);
}

.hero-panel {
  position: relative;
  overflow: hidden;
  padding: 28rpx 30rpx 30rpx;
  background: #ace2df;
}

.kicker {
  display: block;
  margin-bottom: 12rpx;
  color: rgba(13, 13, 13, 0.55);
  font-size: 22rpx;
  font-weight: 900;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #0d0d0d;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.08;
}

.subtitle {
  display: block;
  color: rgba(13, 13, 13, 0.72);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.48;
}

.notice-card {
  padding: 26rpx;
  background: #e7db4c;
}

.notice-title,
.section-title,
.account-name,
.upload-title,
.control-label {
  display: block;
  color: #0d0d0d;
  font-weight: 900;
}

.notice-title {
  margin-bottom: 10rpx;
  font-size: 30rpx;
}

.notice-copy {
  display: block;
  margin-bottom: 20rpx;
  color: rgba(13, 13, 13, 0.72);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
}

.section {
  padding: 24rpx;
  background: #fff;
}

.mode-reference-section {
  padding-bottom: 20rpx;
}

.mode-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.mode-chip {
  width: 100% !important;
  min-width: 0;
  min-height: 70rpx;
  padding: 0 18rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #fff;
  color: #0d0d0d;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 5rpx 5rpx 0 rgba(13, 13, 13, 0.12);
}

.mode-chip.active {
  background: #e7db4c;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.compact-head {
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 32rpx;
}

.section-hint {
  color: rgba(13, 13, 13, 0.48);
  font-size: 23rpx;
  font-weight: 800;
}

.account-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #f6e0db;
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-name {
  margin-bottom: 8rpx;
  font-size: 29rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-desc {
  display: block;
  color: rgba(13, 13, 13, 0.62);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.36;
}

.small-button {
  width: auto !important;
  min-width: 144rpx;
  height: 66rpx;
  padding: 0 22rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #ef724f;
  color: #0d0d0d;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 5rpx 5rpx 0 rgba(13, 13, 13, 0.14);
}

.lemon {
  background: #e7db4c;
}

.white {
  background: #fff;
}

.image-card {
  overflow: hidden;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #f6e0db;
}

.reference-scroll {
  width: 100%;
  padding: 14rpx 0 6rpx;
  white-space: nowrap;
}

.reference-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 16rpx;
}

.reference-item {
  display: flex;
  flex-direction: column;
  width: 220rpx;
  flex: 0 0 220rpx;
  min-width: 220rpx;
}

.reference-image {
  display: block;
  width: 100%;
  height: 292rpx;
  border: 3rpx solid #0d0d0d;
  border-radius: 8px;
  background: #ececec;
}

.remove-chip {
  width: 100% !important;
  height: 58rpx;
  margin-top: 10rpx;
  padding: 0;
  border: 3rpx solid #0d0d0d;
  border-radius: 8px;
  background: #fff;
  color: #0d0d0d;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 54rpx;
}

.image-actions {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 16rpx 16rpx;
}

.text-mode-card {
  padding: 20rpx;
  border: 4rpx dashed #0d0d0d;
  border-radius: 8px;
  background: #f6e0db;
}

.text-mode-title {
  display: block;
  margin-bottom: 8rpx;
  color: #0d0d0d;
  font-size: 28rpx;
  font-weight: 900;
}

.text-mode-desc {
  display: block;
  margin-bottom: 16rpx;
  color: rgba(13, 13, 13, 0.62);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.42;
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-height: 250rpx;
  border: 4rpx dashed #0d0d0d;
  border-radius: 8px;
  background: #f6e0db;
}

.upload-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin-bottom: 14rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 50%;
  background: #e7db4c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.upload-title {
  margin-bottom: 8rpx;
  font-size: 29rpx;
}

.upload-desc {
  color: rgba(13, 13, 13, 0.56);
  font-size: 24rpx;
  font-weight: 700;
}

.form-section {
  background: #ace2df;
}

.text-button {
  width: auto !important;
  color: #0d0d0d;
  font-size: 24rpx;
  font-weight: 900;
  text-decoration: underline;
}

.input,
.textarea,
.picker-box {
  box-sizing: border-box;
  width: 100%;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #fff;
  color: #0d0d0d;
  font-size: 27rpx;
  font-weight: 700;
}

.input {
  height: 82rpx;
  margin-bottom: 18rpx;
  padding: 0 22rpx;
}

.textarea {
  min-height: 260rpx;
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  line-height: 1.48;
}

.prompt-block-card {
  margin-bottom: 18rpx;
  padding: 18rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #fff;
}

.prompt-block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.prompt-block-title,
.prompt-final-label,
.prompt-slot-label {
  color: #0d0d0d;
  font-weight: 900;
}

.prompt-block-title {
  font-size: 27rpx;
}

.prompt-block-hint {
  color: rgba(13, 13, 13, 0.48);
  font-size: 20rpx;
  font-weight: 800;
  text-align: right;
}

.prompt-slot-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.prompt-slot-label {
  flex: 0 0 126rpx;
  font-size: 24rpx;
}

.prompt-slot-input {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 70rpx;
  padding: 0 16rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #e7db4c;
  color: #0d0d0d;
  font-size: 25rpx;
  font-weight: 800;
}

.visual-slot-input {
  background: #ace2df;
}

.content-slot-input {
  background: #e7db4c;
}

.prompt-pattern-preview {
  margin-top: 16rpx;
  padding: 16rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #f6e0db;
}

.prompt-pattern-label {
  display: block;
  margin-bottom: 8rpx;
  color: rgba(13, 13, 13, 0.55);
  font-size: 20rpx;
  font-weight: 900;
}

.prompt-pattern-text {
  display: block;
  color: #0d0d0d;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.48;
}

.prompt-final-card {
  margin-top: 16rpx;
  padding: 16rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #f6e0db;
}

.prompt-final-label {
  display: block;
  margin-bottom: 8rpx;
  color: rgba(13, 13, 13, 0.55);
  font-size: 20rpx;
}

.prompt-final-text {
  display: block;
  color: rgba(13, 13, 13, 0.76);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.5;
}

.control-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.estimate-line {
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #e7db4c;
  color: #0d0d0d;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
}

.estimate-line.error {
  background: #fff;
  color: #ef724f;
}

.control {
  flex: 1;
  min-width: 0;
}

.compact {
  flex: 0 0 160rpx;
}

.control-label {
  margin-bottom: 10rpx;
  font-size: 23rpx;
}

.picker-box {
  height: 74rpx;
  padding: 18rpx 20rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-button {
  width: 100% !important;
  height: 90rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #ef724f;
  box-shadow: 8rpx 8rpx 0 rgba(13, 13, 13, 0.14);
  color: #0d0d0d;
  font-size: 30rpx;
  font-weight: 900;
}
