.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 64rpx;
  background: #f6e0db;
}

.topbar {
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr) 68rpx;
  align-items: center;
  margin-bottom: 26rpx;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx !important;
  height: 68rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #fff;
  color: #0d0d0d;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  font-weight: 900;
  line-height: 1;
}

.brand-main,
.brand-accent {
  font-size: 29rpx;
}

.brand-accent {
  color: #ef724f;
}

.status-dot {
  width: 28rpx;
  height: 28rpx;
  justify-self: end;
  border: 4rpx solid #0d0d0d;
  border-radius: 50%;
  background: #ace2df;
}

.legal-card {
  padding: 30rpx 28rpx 34rpx;
  border: 4rpx solid #0d0d0d;
  border-radius: 8px;
  background: #fff;
  box-shadow: 8rpx 8rpx 0 rgba(13, 13, 13, 0.13);
}

.kicker,
.updated,
.paragraph,
.heading,
.title {
  display: block;
}

.kicker {
  margin-bottom: 10rpx;
  color: rgba(13, 13, 13, 0.52);
  font-size: 21rpx;
  font-weight: 900;
}

.title {
  margin-bottom: 8rpx;
  color: #0d0d0d;
  font-size: 46rpx;
  font-weight: 900;
}

.updated {
  margin-bottom: 28rpx;
  color: rgba(13, 13, 13, 0.5);
  font-size: 22rpx;
  font-weight: 700;
}

.heading {
  margin-top: 24rpx;
  margin-bottom: 10rpx;
  color: #0d0d0d;
  font-size: 29rpx;
  font-weight: 900;
}

.paragraph {
  color: rgba(13, 13, 13, 0.74);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.7;
}
