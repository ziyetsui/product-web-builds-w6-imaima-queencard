# Standalone durable image-generation worker
GENERATION_WORKER_ENABLED=false
GENERATION_WORKER_CONCURRENCY=4
GENERATION_GLOBAL_CONCURRENCY=4
GENERATION_USER_CONCURRENCY=1
GENERATION_PROVIDER_MODEL_CONCURRENCY=2
GENERATION_TASK_MAX_ATTEMPTS=3
GENERATION_LEASE_MS=120000
GENERATION_HEARTBEAT_MS=30000
GENERATION_PROVIDER_TIMEOUT_MS=300000
GENERATION_QUEUE_POLL_MIN_MS=1000
GENERATION_QUEUE_POLL_MAX_MS=5000
GENERATION_QUEUE_CANDIDATE_BATCH=20
GENERATION_ASYNC_ROLLOUT_PERCENT=100
GENERATION_RECOVERY_INTERVAL_MS=30000
WORKER_HEALTH_PORT=8081

# Operations notifications (Feishu first, admin email fallback)
FEISHU_OPS_WEBHOOK_URL=
OPS_ALERT_EMAIL=

# GPTProto resilience. The fallback must expose the same GPTProto-compatible
# endpoints used by the configured models. Balance monitoring is optional
# because GPTProto does not document a public balance API; when supplied, the
# endpoint must return { "balanceCny": number } (also accepted under data).
GPTPROTO_FALLBACK_API_KEY=
GPTPROTO_FALLBACK_BASE_URL=https://gptproto.com
GPTPROTO_BALANCE_API_URL=
GPTPROTO_LOW_BALANCE_CNY=500
GPTPROTO_BALANCE_CHECK_INTERVAL_MS=900000

# Waffo Pancake MoR (server-side; begin with test-mode products)
NEXT_PUBLIC_BILLING_PROVIDER=waffo
WAFFO_MERCHANT_ID=MER_replace_me
WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
WAFFO_PRODUCT_CREATOR_MONTHLY=PROD_replace_me
WAFFO_PRODUCT_CREATOR_ANNUAL=PROD_replace_me
WAFFO_PRODUCT_STUDIO_MONTHLY=PROD_replace_me
WAFFO_PRODUCT_STUDIO_ANNUAL=PROD_replace_me
WAFFO_PRODUCT_CREDIT_CREATOR=PROD_replace_me
WAFFO_PRODUCT_CREDIT_STUDIO=PROD_replace_me
