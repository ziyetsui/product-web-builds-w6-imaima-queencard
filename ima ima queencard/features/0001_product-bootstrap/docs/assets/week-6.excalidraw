    {
      "id": "42fCiFRGNNbcopYHO-p5C",
      "type": "text",
      "x": -625.1470984719354,
      "y": 888.5763313758507,
      "width": 2213.883448163034,
      "height": 334.73086269992297,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VoUMxEiL6otrIC8L5MpE5"
      ],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1406338611,
      "version": 681,
      "versionNonce": 1987723165,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767553122654,
      "link": null,
      "locked": false,
      "text": "AI Agent 核心原理与设计模式。\n多 Agent 协作与任务流编排。\nClaude Code 与 Codex 的 Agent 架构分析。\n通用 Agent 内核的实现要点。\n实践：构建一个通用 Agent 内核，并在此基础上实现一个功能强大的 Code Review Agent。",
      "fontSize": 53.55693803198767,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AI Agent 核心原理与设计模式。\n多 Agent 协作与任务流编排。\nClaude Code 与 Codex 的 Agent 架构分析。\n通用 Agent 内核的实现要点。\n实践：构建一个通用 Agent 内核，并在此基础上实现一个功能强大的 Code Review Agent。",
      "autoResize": true,
      "lineHeight": 1.25
    },
