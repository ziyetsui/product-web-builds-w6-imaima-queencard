NEXT_PUBLIC_APP_URL=http://localhost:8080
NEXT_PUBLIC_BILLING_PROVIDER=creem
BETTER_AUTH_SECRET=
DATABASE_URL=

# Creem billing. Keep API/webhook secrets server-only.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_API_BASE_URL=https://test-api.creem.io/v1

# Creem product catalog. Test Product IDs are safe for local/staging only.
CREEM_PRODUCT_CREATOR_MONTHLY=prod_5oY1tymF5Z1BVzSf6senQ9
CREEM_PRODUCT_CREATOR_ANNUAL=prod_3Vp6IL6sR9WcILqBmjJJQY
CREEM_PRODUCT_STUDIO_MONTHLY=prod_2WqxlnsxI13bcwFVj0dDJx
CREEM_PRODUCT_STUDIO_ANNUAL=prod_5rdfSAfjwkc4c0v3WuvW5e
CREEM_PRODUCT_CREDIT_CREATOR=prod_MpQpZNBEIqYQLDWlqOWXp
CREEM_PRODUCT_CREDIT_STUDIO=prod_55Wb84h6LVWyXfH9ABlnwu

# Stripe legacy fallback. Keep Stripe Price IDs server-only.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_CREDIT_CREATOR=
STRIPE_PRICE_CREDIT_STUDIO=

# Image generation provider. Keep provider keys server-only; never expose them as NEXT_PUBLIC_*.
IMAGE_PROVIDER=gptproto
GPTPROTO_API_KEY=
GPTPROTO_BASE_URL=https://gptproto.com
GPTPROTO_IMAGE_TIMEOUT_MS=300000
GPTPROTO_POLL_INTERVAL_MS=2000
GPTPROTO_MAX_POLL_ATTEMPTS=120

# Optional fallback provider.
APIYI_API_KEY=
APIYI_BASE_URL=https://api.apiyi.com
APIYI_IMAGE_TIMEOUT_MS=300000

EMAIL_PROVIDER=zeabur
ZEABUR_EMAIL_API_KEY=
ZEABUR_EMAIL_FROM=
ZEABUR_EMAIL_API_URL=https://api.zeabur.com/api/v1/zsend/emails

RESEND_API_KEY=
RESEND_FROM=

NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ADMIN_EMAIL=iven_chloe@icloud.com
SUPERADMIN_EMAILS=iven_chloe@icloud.com
IS_DEBUG=false
